  "known_gaps": {
    "MR1/episode/fragment-far-negation": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "episode._negated reads only the last 3 words before a quote and only not/no/never-type words: after 'Avoid', 'Stop', 'It is unsafe to', 'It is dangerous to', 'Under no circumstances should she' or 'You must not, under any circumstances,' the fragment is accepted and shown as a positive instruction (guardrails.quote_negated, the extractor's copy, refuses all of them)"
    },
    "MR1/episode/whole-far-negation": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "FLIPS has no 'avoid', 'unsafe', 'dangerous': a whole-sentence quote 'Avoid taking X' / 'It is unsafe to X' with what 'Take X' passes the what-keeps-the-negation check and _keep_negation keeps the positive what"
    },
    "MR1/episode/fragment-post-negation": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "a negation after the quote ('Taking X is not allowed') is never read: the fragment 'Taking X' is accepted as a positive instruction"
    },
    "MR1/episode/whole-post-negation": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "'X must be avoided' quoted whole with what 'Do X': 'avoided' is in no FLIPS group, so the positive what is kept"
    },
    "MR1/episode/plan-negated": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "a plan fact (follow_up, procedure_planned, expected_discharge) from a sentence that says it will NOT happen is accepted: the what-keeps-the-negation check applies only to SAFETY types, and plans without 'what' are never checked for a negation"
    },
    "MR1/reply/own-words-reversal": {
      "owner": "design (main conversation)",
      "why": "check_reply has no rule for an own-words action outside the get-up instruction: 'Please take X.' passes next to a current source 'Do not take X.' (the design relies on verbatim quotes; there is no action-level oracle)"
    },
    "MR2/episode-instruction/amount-candidate-accepted": {
      "owner": "handoff_day1/agent/episode.py",
      "why": "grounding_problem checks the digits of a 'what' field but not number words or doses (dose_facts): 'Give her four mg ...' from a quote 'Give her two mg ...' is accepted"
    },
    "MR2/episode-instruction/unit-candidate-accepted": {
      "owner": "handoff_day1/agent/episode.py",
