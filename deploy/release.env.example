CARERELAY_LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
CARERELAY_LLM_MODEL=DeepSeek-V4-Flash
# Candidate selected by two file-level smoke checks; still requires text review.
CARERELAY_PHOTO_MODEL=Gemma-4-31B-IT
# Set the real key in the deployment platform's secret settings; never commit it.
CARERELAY_LLM_API_KEY=
CARERELAY_LLM_GUIDED_JSON=0
CARERELAY_LLM_TIMEOUT_S=120
CARERELAY_ASR_MODEL=base.en
# Mount persistent storage here; an ephemeral container filesystem is not durable.
CARERELAY_STATE_DIR=/var/lib/kindredrelay
PORT=8501
# Optional offline evidence verifier. Keep off until a model bundle is available.
KINDRED_VERIFIER_MODE=off
KINDRED_VERIFIER_DIR=
KINDRED_VERIFIER_THREADS=2
